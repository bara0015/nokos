# ====================== DATABASE ======================
# SQLite (paling gampang untuk mulai)
DATABASE_URL="file:./dev.db"

# Atau PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/nokos"

# ====================== NEXTAUTH ======================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-ini-dengan-string-random-panjang-minimal-32-karakter"

# ====================== NOKOS.ID ======================
# Ambil di: https://nokos.id/dashboard/api-keys
# WAJIB whitelist IP server kamu
NOKOS_API_KEY="ISI_API_KEY_NOKOS_ID_DISINI"
NOKOS_BASE_URL="https://nokos.id"

# Markup harga jual (contoh: 40 = naik 40% dari harga beli)
MARKUP_PERCENT="40"

# ====================== TEMANQRIS ======================
# Ambil di: https://temanqris.com
TEMANQRIS_API_KEY="ISI_API_KEY_TEMANQRIS_DISINI"
TEMANQRIS_WEBHOOK_SECRET="ISI_WEBHOOK_SECRET_DISINI"

# Setelah deploy, ganti jadi domain kamu
TEMANQRIS_WEBHOOK_URL="http://localhost:3000/api/webhooks/temanqris"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NokosStore"
